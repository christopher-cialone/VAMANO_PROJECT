{
  "name": "vamano",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.0.1",
  "workspaces": [
    "frontend",
    "programs/*",
    "backend",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace frontend dev\" \"yarn workspace backend dev\"",
    "build": "yarn workspace frontend build && yarn workspace backend build",
    "test": "yarn workspace tests test",
    "deploy": "yarn workspace programs deploy"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
