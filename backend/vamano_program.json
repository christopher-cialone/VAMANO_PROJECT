{
  "version": "0.1.0",
  "name": "vamano_program",
  "instructions": [
    {
      "name": "initEvent",
      "docs": [
        "Initialize a new event with MPL-Hybrid support",
        "Creates event PDA with collection metadata for fungible-to-NFT swaps"
      ],
      "accounts": [
        {
          "name": "event",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "creator",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "date",
          "type": "i64"
        },
        {
          "name": "venue",
          "type": "string"
        },
        {
          "name": "supply",
          "type": "u64"
        },
        {
          "name": "metadataUri",
          "type": "string"
        },
        {
          "name": "priceUsdc",
          "type": "u64"
        }
      ]
    },
    {
      "name": "mintTicket",
      "docs": [
        "Mint ticket with MPL-Hybrid logic",
        "Simulates: USDC escrow → Hybrid pool → NFT mint with unique traits",
        "In production: CPI to mpl-hybrid for fungible-to-NFT conversion"
      ],
      "accounts": [
        {
          "name": "event",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "buyer",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        },
        {
          "name": "zkEnabled",
          "type": "bool"
        }
      ]
    },
    {
      "name": "rerollTicket",
      "docs": [
        "Re-roll dynamic traits for hybrid NFT",
        "Allows updating NFT metadata (e.g., seat reassignment, tier upgrade)"
      ],
      "accounts": [
        {
          "name": "event",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "ticketId",
          "type": "u64"
        },
        {
          "name": "newTraitSeed",
          "type": "u64"
        }
      ]
    },
    {
      "name": "verifyTicket",
      "docs": [
        "Verify ticket ownership via QR scan",
        "Called by off-chain verifier (e.g., door scanner)"
      ],
      "accounts": [
        {
          "name": "event",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "ticketHolder",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "ticketId",
          "type": "u64"
        },
        {
          "name": "qrHash",
          "type": "string"
        }
      ]
    },
    {
      "name": "enforceRoyalties",
      "docs": [
        "Enforce royalties on resale with MPL-Hybrid swap",
        "10% total: 5% artist, 3% organizer, 2% platform",
        "Called automatically on secondary market transfers"
      ],
      "accounts": [
        {
          "name": "event",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "seller",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "artist",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "organizer",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "platform",
          "isMut": true,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "saleAmount",
          "type": "u64"
        }
      ]
    }
  ],
